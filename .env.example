# MONGO_URI is also accepted. If absent, the demo uses MONGODB_SEED_URI for reads.
# Prefer a dedicated read-only credential outside this single-operator demo.
MONGODB_URI=
# Administrative seed credential; fallback for the authorized synthetic demo reads.
MONGODB_SEED_URI=
OPENAI_API_KEY=
# Preferred for this hackathon. Auth uses DefaultAzureCredential (Azure CLI/VS Code/etc.).
AZURE_ENDPOINT=https://replace-me.services.ai.azure.com/api/projects/replace-me
AZURE_LLM_MODEL=
# When Azure is configured, retry availability failures through OpenAI.
OPENAI_FALLBACK_ENABLED=true
OPENAI_FALLBACK_MODEL=gpt-6-luna
LINEAR_API_TOKEN=
LINEAR_TEAM_ID=
DEMO_LINEAR_ISSUE_ID=
E2B_API_KEY=
# E2B_SANDBOX is accepted as an alias for the API key.
E2B_TEMPLATE=base
# Generate locally with: python -m app.cli init
MCP_AUTH_TOKEN=
TRUEFORGE_BASE_URL=http://127.0.0.1:8790
TRUEFORGE_BEARER_TOKEN=
# Used when Azure is not configured.
TRUEFORGE_MODEL_NAME=openai/gpt-6-luna
